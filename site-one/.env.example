# Не добавляйте настоящий .env в Git.
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phpmytech
DB_USER=phpmytech
DB_PASSWORD=замените-на-длинный-случайный-пароль-базы
DB_ROOT_PASSWORD=замените-на-другой-пароль-root

# Этот аккаунт создаётся только один раз, если в БД ещё нет superadmin.
BOOTSTRAP_SUPERADMIN_USERNAME=Super_Admin
BOOTSTRAP_SUPERADMIN_PASSWORD=замените-на-длинный-пароль-superadmin
# В production вместо пароля выше используйте результат npm run hash-password:
# BOOTSTRAP_SUPERADMIN_PASSWORD_HASH=scrypt:...

# Самый высокий уровень. Может управлять всеми ролями, включая developer.
BOOTSTRAP_DEVELOPER_USERNAME=Developer
BOOTSTRAP_DEVELOPER_PASSWORD=замените-на-длинный-пароль-developer
# BOOTSTRAP_DEVELOPER_PASSWORD_HASH=scrypt:...
