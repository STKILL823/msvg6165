# Обязательные параметры. Не добавляйте настоящий .env в Git.
APP_USERNAME=Nick_Name
APP_PASSWORD_HASH=вставьте_результат_команды_npm_run_hash-password

# Для локального запуска можно временно задать APP_PASSWORD вместо хеша.
# APP_PASSWORD=замените-на-длинный-случайный-пароль

PORT=3000
NODE_ENV=development
# Если приложение стоит за доверенным reverse proxy, укажите число прокси-переходов.
TRUST_PROXY_HOPS=0

